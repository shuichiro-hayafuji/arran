{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Arran limited CDK bootstrap: one production stack, bounded backup writer, no administrator fallback.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "why": "Derived from modern CDK bootstrap version 32; managed independently by administrator.",
      "must": [
        "Tokyo only; stack name CDKToolkit",
        "Never run default cdk bootstrap over this stack",
        "No ECR/image assets, lookups, cross-account publishing or arbitrary application stacks"
      ]
    }
  },
  "Parameters": {
    "BootstrapVariant": {
      "Type": "String",
      "Default": "Arran limited production v1",
      "AllowedValues": [
        "Arran limited production v1"
      ]
    },
    "OperatorUserName": {
      "Type": "String",
      "Default": "arran-operator",
      "AllowedPattern": "[A-Za-z0-9+=,.@_-]{1,64}"
    }
  },
  "Rules": {
    "TokyoOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-northeast-1"
            ]
          },
          "AssertDescription": "Deploy only in Tokyo"
        }
      ]
    }
  },
  "Resources": {
    "StagingBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Retained staging for CloudFormation templates and file assets.",
          "must": [
            "Private, TLS only, SSE-S3, versioned",
            "Never store application secrets"
          ]
        }
      },
      "Properties": {
        "BucketName": {
          "Fn::Sub": "cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "OldAssetVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "StagingBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Block cleartext transport without granting new access.",
          "must": [
            "No public or user-ARN allow grants"
          ]
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "StagingBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Action": [
                "s3:*"
              ],
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "BackupWriterBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Administrator-owned ceiling for the application backup user.",
          "must": [
            "Execution role cannot change or detach this ceiling"
          ]
        }
      },
      "Properties": {
        "ManagedPolicyName": "arran-production-backup-writer-boundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:PutObject",
                "s3:AbortMultipartUpload"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::arran-production-backups-${AWS::AccountId}-${AWS::Region}/postgres/*"
              }
            }
          ]
        }
      }
    },
    "CloudFormationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "CloudFormation service role for application resources only.",
          "must": [
            "No bootstrap or administrator policy management",
            "SourceArn/SourceAccount not assumed to exist for ordinary stack service-role sessions"
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "cdk-hnb659fds-cfn-exec-role-${AWS::AccountId}-${AWS::Region}"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:AssumeRole"
              ],
              "Principal": {
                "Service": "cloudformation.amazonaws.com"
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "arran-production-only",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/cdk-bootstrap/hnb659fds/version"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lightsail:CreateInstances"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1",
                      "aws:RequestTag/Project": "arran",
                      "aws:RequestTag/Environment": "production"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lightsail:AllocateStaticIp",
                    "lightsail:EnableAddOn",
                    "lightsail:DisableAddOn",
                    "lightsail:GetInstance",
                    "lightsail:GetInstances",
                    "lightsail:GetStaticIp",
                    "lightsail:GetStaticIps",
                    "lightsail:GetOperation",
                    "lightsail:GetOperations",
                    "lightsail:GetRegions"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lightsail:DeleteInstance",
                    "lightsail:StartInstance",
                    "lightsail:StopInstance",
                    "lightsail:PutInstancePublicPorts",
                    "lightsail:TagResource",
                    "lightsail:UntagResource"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lightsail:${AWS::Region}:${AWS::AccountId}:Instance/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1",
                      "aws:ResourceTag/Project": "arran",
                      "aws:ResourceTag/Environment": "production"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lightsail:AttachStaticIp"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lightsail:${AWS::Region}:${AWS::AccountId}:Instance/*"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:lightsail:${AWS::Region}:${AWS::AccountId}:StaticIp/*"
                    }
                  ],
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "lightsail:DetachStaticIp",
                    "lightsail:ReleaseStaticIp"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:lightsail:${AWS::Region}:${AWS::AccountId}:StaticIp/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:CreateBucket",
                    "s3:DeleteBucket",
                    "s3:GetBucketLocation",
                    "s3:GetBucketTagging",
                    "s3:PutBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:PutBucketVersioning",
                    "s3:GetEncryptionConfiguration",
                    "s3:PutEncryptionConfiguration",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:PutBucketPublicAccessBlock",
                    "s3:GetLifecycleConfiguration",
                    "s3:PutLifecycleConfiguration",
                    "s3:GetBucketPolicy",
                    "s3:PutBucketPolicy",
                    "s3:DeleteBucketPolicy",
                    "s3:GetBucketOwnershipControls",
                    "s3:PutBucketOwnershipControls",
                    "s3:ListBucket",
                    "s3:GetAccelerateConfiguration",
                    "s3:GetAnalyticsConfiguration",
                    "s3:GetBucketCORS",
                    "s3:GetInventoryConfiguration",
                    "s3:GetBucketLogging",
                    "s3:GetMetricsConfiguration",
                    "s3:GetBucketNotification",
                    "s3:GetReplicationConfiguration",
                    "s3:GetBucketWebsite",
                    "s3:GetBucketObjectLockConfiguration",
                    "s3:ListTagsForResource",
                    "s3:GetBucketAbac",
                    "s3:GetIntelligentTieringConfiguration",
                    "s3:GetBucketMetadataTableConfiguration",
                    "s3:GetBucketAcl"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::arran-production-backups-${AWS::AccountId}-${AWS::Region}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:CreateUser",
                    "iam:PutUserPermissionsBoundary"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/arran-production-backup-writer"
                  },
                  "Condition": {
                    "ArnEquals": {
                      "iam:PermissionsBoundary": {
                        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/arran-production-backup-writer-boundary"
                      }
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetUser",
                    "iam:TagUser",
                    "iam:UntagUser",
                    "iam:ListUserPolicies",
                    "iam:GetUserPolicy",
                    "iam:PutUserPolicy",
                    "iam:DeleteUserPolicy",
                    "iam:ListAttachedUserPolicies",
                    "iam:ListGroupsForUser",
                    "iam:GetLoginProfile",
                    "iam:ListUserTags"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/arran-production-backup-writer"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:GetPolicy",
                    "iam:GetPolicyVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/arran-production-backup-writer-boundary"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "iam:DeleteUserPermissionsBoundary"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/arran-production-backup-writer"
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "iam:CreateUser",
                    "iam:PutUserPermissionsBoundary"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:user/arran-production-backup-writer"
                  },
                  "Condition": {
                    "ArnNotEquals": {
                      "iam:PermissionsBoundary": {
                        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/arran-production-backup-writer-boundary"
                      }
                    }
                  }
                },
                {
                  "Effect": "Deny",
                  "Action": [
                    "iam:CreatePolicyVersion",
                    "iam:DeletePolicy",
                    "iam:DeletePolicyVersion",
                    "iam:SetDefaultPolicyVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/arran-production-backup-writer-boundary"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "DeploymentActionRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Existing deployment broker is the sole caller; one hour sessions.",
          "must": [
            "No account-root or cross-account trust",
            "No managed administrator policies"
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "cdk-hnb659fds-deploy-role-${AWS::AccountId}-${AWS::Region}"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession"
              ],
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/ArranCdkDeployerTokyo"
                }
              },
              "Condition": {
                "Null": {
                  "sts:ExternalId": "true"
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "aws-cdk:bootstrap-role",
            "Value": "deploy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "arran-limited",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:CreateChangeSet",
                    "cloudformation:CreateStack",
                    "cloudformation:UpdateStack"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/arran-production/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "cloudformation:RoleArn": {
                        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-cfn-exec-role-${AWS::AccountId}-${AWS::Region}"
                      },
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DeleteChangeSet",
                    "cloudformation:ExecuteChangeSet",
                    "cloudformation:DescribeChangeSet",
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents",
                    "cloudformation:GetTemplate",
                    "cloudformation:GetTemplateSummary",
                    "cloudformation:ListStackResources",
                    "cloudformation:DescribeStackResources",
                    "cloudformation:RollbackStack",
                    "cloudformation:ContinueUpdateRollback",
                    "cloudformation:UpdateTerminationProtection"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/arran-production/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudformation:DescribeStacks",
                    "cloudformation:DescribeStackEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/CDKToolkit/*"
                  },
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-1"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:PassRole"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-cfn-exec-role-${AWS::AccountId}-${AWS::Region}"
                  },
                  "Condition": {
                    "StringEquals": {
                      "iam:PassedToService": "cloudformation.amazonaws.com"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter",
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/cdk-bootstrap/hnb659fds/version"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "FilePublishingRole": {
      "Type": "AWS::IAM::Role",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Existing deployment broker is the sole caller; one hour sessions.",
          "must": [
            "No account-root or cross-account trust",
            "No managed administrator policies"
          ]
        }
      },
      "Properties": {
        "RoleName": {
          "Fn::Sub": "cdk-hnb659fds-file-publishing-role-${AWS::AccountId}-${AWS::Region}"
        },
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "sts:AssumeRole",
                "sts:TagSession"
              ],
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/ArranCdkDeployerTokyo"
                }
              },
              "Condition": {
                "Null": {
                  "sts:ExternalId": "true"
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "aws-cdk:bootstrap-role",
            "Value": "file-publishing"
          }
        ],
        "Policies": [
          {
            "PolicyName": "arran-limited",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation",
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:AbortMultipartUpload",
                    "s3:ListMultipartUploadParts"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CdkBootstrapVersion": {
      "Type": "AWS::SSM::Parameter",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Modern CDK CLI bootstrap compatibility marker.",
          "must": [
            "Marker does not advertise support for omitted image/lookup roles"
          ]
        }
      },
      "Properties": {
        "Type": "String",
        "Name": "/cdk-bootstrap/hnb659fds/version",
        "Value": "32"
      }
    },
    "OperatorBootstrapReadPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Add separate verification policy without replacing existing operator access.",
          "must": [
            "Application execution role cannot edit this user"
          ]
        }
      },
      "Properties": {
        "Users": [
          {
            "Ref": "OperatorUserName"
          }
        ],
        "ManagedPolicyName": "ArranCdkToolkitReadTokyo",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "cloudformation:DescribeStacks",
                "cloudformation:DescribeStackEvents",
                "cloudformation:ListStackResources"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/CDKToolkit/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-1"
                }
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:ListRolePolicies",
                "iam:ListAttachedRolePolicies",
                "iam:GetRolePolicy"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-deploy-role-${AWS::AccountId}-${AWS::Region}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-file-publishing-role-${AWS::AccountId}-${AWS::Region}"
                },
                {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/cdk-hnb659fds-cfn-exec-role-${AWS::AccountId}-${AWS::Region}"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "iam:GetPolicy",
                "iam:GetPolicyVersion"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:policy/arran-production-backup-writer-boundary"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "ssm:GetParameter"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/cdk-bootstrap/hnb659fds/version"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetEncryptionConfiguration",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketPolicy",
                "s3:GetBucketVersioning",
                "s3:GetLifecycleConfiguration",
                "s3:GetBucketOwnershipControls"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:s3:::cdk-hnb659fds-assets-${AWS::AccountId}-${AWS::Region}"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "StagingBucket"
      }
    },
    "BucketDomainName": {
      "Value": {
        "Fn::GetAtt": [
          "StagingBucket",
          "RegionalDomainName"
        ]
      }
    },
    "BootstrapVersion": {
      "Value": "32"
    },
    "BootstrapVariant": {
      "Value": {
        "Ref": "BootstrapVariant"
      }
    },
    "BackupWriterBoundaryArn": {
      "Value": {
        "Ref": "BackupWriterBoundary"
      }
    }
  }
}
