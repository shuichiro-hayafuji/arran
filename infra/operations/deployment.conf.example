# Copy to deploy.env on the host (root-owned, mode 0600).
# No credentials in this file. Use an immutable release tag for the API,
# and replace example image placeholders with verified linux/amd64 digests.
DOMAIN=
API_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=
BACKUP_BUCKET=
AWS_PROFILE=arran-backup
AWS_DEFAULT_REGION=ap-northeast-1
OPENAI_MODEL=gpt-5.6-terra
# Leave empty until the reviewed policy text and matching version are installed.
AI_CONSENT_VERSION=
