# Copy this file to server/.env and set values for local development.
# Never commit .env or an API key.
# Listen on the Mac's LAN interfaces for a physical phone on the same Wi-Fi.
API_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://spendable_today:local-only-password@127.0.0.1:5432/spendable_today?sslmode=disable
USE_MOCK_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
