{
  "description": "Arran: format changed working files at turn end, then notify locally; no automatic staging.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex_hooks.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/codex_hooks.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
