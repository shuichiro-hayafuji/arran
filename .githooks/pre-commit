#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
files=()
while IFS= read -r -d '' file; do
  case "$file" in
    mobile/*.dart)
      if ! git diff --quiet -- "$file"; then
        printf 'Dart format: partially staged file: %s\nFormat and stage the intended changes before retrying.\n' "$file" >&2
        exit 1
      fi
      if [[ -L "$file" ]]; then
        printf 'Dart format: refusing symlink: %s\n' "$file" >&2
        exit 1
      fi
      files+=("${file#mobile/}")
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
[[ ${#files[@]} -gt 0 ]] || exit 0
cd mobile
fvm dart format "${files[@]}"
# Add only the files that were already fully staged.
for file in "${files[@]}"; do
  git add -- "$file"
done
